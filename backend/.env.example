PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/master_dnd
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d
NODE_ENV=development

# Real OTP Delivery Mode (set to true to generate dynamic unique 6-digit codes)
REAL_OTP=true

# Optional dedicated Play Store reviewer account (non-expiring OTP for app review)
REVIEWER_EMAIL=
REVIEWER_OTP=

# Nodemailer / SMTP Configuration for REAL Email OTP delivery
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@zohomail.in
SMTP_PASS=your_email_password
SMTP_FROM="Master DND" <your_email@zohomail.in>

# Twilio SMS Configuration for REAL Phone SMS delivery (Optional)
# https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Fast2SMS Configuration for REAL Indian Phone SMS delivery (Optional)
# https://www.fast2sms.com
FAST2SMS_API_KEY=
